# docker-compose ile `api` servisini çalıştırmadan önce bu dosyayı `.env` olarak kopyalayıp
# gerçek değerlerle doldurun: cp .env.example .env

# JWT imzalama anahtarı (en az 32 karakter, rastgele üretin)
JWT_KEY=

# Otomatik oluşturulan admin kullanıcısının şifresi
ADMIN_SEED_PASSWORD=

# Frontend'in canlıda yayınlandığı origin (CORS için)
FRONTEND_ORIGIN=http://localhost:5173
