# docker-compose ile `api` servisini çalıştırmadan önce bu dosyayı `.env` olarak kopyalayıp
# gerçek değerlerle doldurun: cp .env.example .env

# JWT imzalama anahtarı (en az 32 karakter, rastgele üretin)
JWT_KEY=

# Otomatik oluşturulan, kısıtlı (demo) admin kullanıcısının şifresi
# Bu hesap silme işlemi yapamaz; halka açık demo giriş bilgisi olarak paylaşılabilir.
ADMIN_SEED_PASSWORD=

# Opsiyonel: tam yetkili, kısıtlanmamış ikinci bir admin hesabı.
# Boş bırakılırsa oluşturulmaz. Asla herkese açık paylaşılmamalı.
SUPERADMIN_SEED_EMAIL=
SUPERADMIN_SEED_PASSWORD=

# Frontend'in canlıda yayınlandığı origin (CORS için)
FRONTEND_ORIGIN=http://localhost:5173
